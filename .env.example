# gaozhong.online — 环境变量配置
# 复制为 .env 并填入真实值

# ═══ API 密钥 ═══
# DeepSeek API（文本分析，必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Kimi / 阿里云百炼 API（VL OCR 回退）
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 GLM API（VL 红笔分类 + DirectJudge，必填）
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ═══ TextIn OCR（推荐配置，可选） ═══
# 合合信息 TextIn API — 专用 OCR 引擎
# 获取地址: https://www.textin.com/console/dashboard/overview
# 不设置则自动回退到 VL OCR
TEXTIN_APP_ID=dda97xxxxxxxxxxxxx
TEXTIN_SECRET_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══ 模型配置 ═══
MODEL_OCR=kimi-k2.6
MODEL_GRADING=deepseek-v4-pro
MODEL_ZHIPU_VL=glm-4.6v-flash

# ═══ 服务配置 ═══
PORT=3001
PREPROCESS_URL=http://localhost:5002
JWT_SECRET=change-me-to-a-random-string
